{
  "name": "ZoesDeckTheme",
  "display_name": "Zoe's Deck Theme",
  "author": "zoeallgaier",
  "version": "v0.1",
  "description": "Apple-clean Gaming Mode: Instrument Serif accent titles, Oxygen everywhere else, rounded corners and liquid glass on the UI layer.",
  "target": "System-Wide",
  "manifest_version": 9,
  "flags": ["REQUIRE_NAV_PATCH"],
  "tabs": {
    "everywhere": ["SP", "QuickAccess", "MainMenu"]
  },
  "inject": {
    "shared/tokens.css": ["everywhere"],
    "shared/controls.css": ["everywhere"],
    "shared/gameicons.css": ["everywhere"],
    "shared/icons.css": ["everywhere"],
    "sp/chrome.css": ["SP"],
    "sp/settings.css": ["SP"],
    "home/home.css": ["SP"],
    "sp/gamepage.css": ["SP"],
    "sp/contextmenu.css": ["SP"],
    "sp/dialogs.css": ["SP"],
    "sp/badges.css": ["SP"],
    "sp/downloads.css": ["SP"],
    "sp/account.css": ["SP"],
    "qam/qam.css": ["QuickAccess"],
    "menu/mainmenu.css": ["MainMenu"]
  },
  "patches": {
    "Show What's New on Home": {
      "type": "checkbox",
      "default": "No",
      "values": {
        "Yes": {},
        "No": { "home/hide-whats-new.css": ["SP"] }
      }
    },
    "Reduce transparency": {
      "type": "checkbox",
      "default": "No",
      "values": {
        "Yes": { "options/reduce-transparency.css": ["everywhere"] },
        "No": {}
      }
    },
    "Theme fonts": {
      "type": "checkbox",
      "default": "Yes",
      "values": {
        "Yes": { "shared/type.css": ["everywhere"] },
        "No": {}
      }
    },
    "Accent": {
      "type": "none",
      "default": "Custom",
      "values": { "Custom": {} },
      "components": [
        {
          "name": "Accent color",
          "type": "color-picker",
          "on": "Custom",
          "default": "#ffffff",
          "css_variable": "zdt-accent",
          "tabs": ["everywhere"]
        }
      ]
    }
  }
}
